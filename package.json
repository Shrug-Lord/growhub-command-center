{
  "name": "growhub-command-center",
  "version": "0.1.0",
  "description": "Local control and monitoring server for Growhub CE devices",
  "license": "MIT",
  "author": "Shrug-Lord",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Shrug-Lord/growhub-command-center.git"
  },
  "homepage": "https://github.com/Shrug-Lord/growhub-command-center#readme",
  "bugs": {
    "url": "https://github.com/Shrug-Lord/growhub-command-center/issues"
  },
  "private": true,
  "type": "module",
  "packageManager": "npm@11.16.0",
  "engines": {
    "node": ">=24.7 <25",
    "npm": ">=11"
  },
  "scripts": {
    "setup": "npm ci && npm ci --prefix deploy/server",
    "dev": "vite",
    "dev:server": "npm start --prefix deploy/server",
    "lint": "eslint .",
    "format": "prettier --write src scripts test e2e deploy/server/src deploy/server/test deploy/server/test-support .github *.js *.json",
    "format:check": "prettier --check src scripts test e2e deploy/server/src deploy/server/test deploy/server/test-support .github *.js *.json",
    "test": "npm run test:server && npm run test:client",
    "test:server": "npm test --prefix deploy/server",
    "test:client": "node --test --test-concurrency=1 test/client/apiClient.test.js test/client/chartData.test.js test/client/deviceState.test.js test/client/driftState.test.js test/client/serverAvailability.test.js test/release/releaseReadiness.test.js",
    "test:integration": "node --test --test-concurrency=1 deploy/server/test/apiContracts.test.js deploy/server/test/authApi.test.js deploy/server/test/mqttMirror.test.js deploy/server/test/deviceActions.test.js deploy/server/test/scheduleTemplates.test.js",
    "build": "vite build",
    "preview": "vite preview",
    "test:e2e:smoke": "playwright test --grep @smoke",
    "test:e2e": "playwright test",
    "test:a11y": "playwright test --grep @a11y",
    "test:compose:mqtt": "node scripts/compose-mqtt-smoke.js",
    "security:secrets": "node scripts/secret-scan.js",
    "security:audit": "npm audit --audit-level=high && npm audit --prefix deploy/server --audit-level=high",
    "security:signatures": "npm audit signatures && npm audit signatures --prefix deploy/server",
    "security": "npm run security:secrets && npm run security:audit",
    "verify": "npm run lint && npm run format:check && npm test && npm run test:integration && npm run build && npm run security",
    "release:validate": "node scripts/release-readiness.js",
    "compose:config": "docker compose -f deploy/compose.yml config",
    "compose:build": "docker compose -f deploy/compose.yml build",
    "compose:up": "docker compose -f deploy/compose.yml up -d --build",
    "compose:down": "docker compose -f deploy/compose.yml down",
    "compose:backup": "node scripts/compose-backup.js",
    "compose:restore": "node scripts/compose-restore.js",
    "compose:update": "node scripts/compose-update.js",
    "compose:reset": "node scripts/reset-compose-data.js",
    "reset:dev": "npm --prefix deploy/server run reset:dev --"
  },
  "dependencies": {
    "lucide-react": "^0.263.1",
    "papaparse": "^5.4.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "recharts": "^2.10.3"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^10.7.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "postcss": "^8.4.32",
    "prettier": "^3.9.5",
    "tailwindcss": "^3.4.0",
    "vite": "^7.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
