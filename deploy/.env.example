# Optional Docker Compose deployment overrides.
# Copy this file to deploy/.env. Do not commit deploy/.env.

# Command Center UI/API host port. Port 80 gives http://growhub.local.
GROWHUB_HTTP_PORT=80

# Plain MQTT host port used by CE firmware on the local network.
GROWHUB_MQTT_PORT=1883

LOG_LEVEL=info
TRUSTED_PROXIES=

# Advanced external-broker override. The bundled broker still starts, but the
# server uses this URL. Back up external broker state separately.
# MQTT_URL=mqtts://username:password@broker.example:8883
# MQTT_CLIENT_ID=growhub-command-center-home
